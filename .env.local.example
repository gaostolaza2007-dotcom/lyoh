# ===========================================================================
# MedStudy - Variables de Entorno para Supabase
# ===========================================================================
# Copia este archivo como .env.local y rellena con tus credenciales reales.
#
# 1. Ve a https://supabase.com → tu proyecto → Settings → API
# 2. Copia la URL y la Anon Key.
# 3. Para Google OAuth, configúralo en Authentication → Providers → Google.
# ===========================================================================

# URL de tu proyecto Supabase (ej. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here

# Clave anónima pública (no es secreta, se expone al frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here